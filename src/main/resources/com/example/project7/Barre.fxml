<?xml version="1.0" encoding="UTF-8"?>
<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchorpane1"
            prefHeight="576.0"
            prefWidth="1050.0"
            stylesheets="@css/sidebar.css"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.project7.controller.InterfaceController">

   <children>

      <!-- MENU LATERAL -->
      <BorderPane fx:id="anchorpane2"
                  prefWidth="256.0"
                  minWidth="256.0"
                  maxWidth="256.0"
                  style="-fx-background-color: linear-gradient(to bottom, #eeeeee, #A53960);"
                  AnchorPane.topAnchor="0.0"
                  AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="0.0">

         <!-- LOGO ENSEA ET TITRE AMC -->
         <top>
            <VBox alignment="CENTER"
                  spacing="8.0"
                  style="-fx-padding: 18 0 14 0;">

               <ImageView fitHeight="139.0"
                          fitWidth="178.0"
                          preserveRatio="true">
                  <image>
                     <Image url="@images/ensea.png"/>
                  </image>
               </ImageView>

               <Label text="AMC"
                      textFill="#A53960"
                      style="-fx-font-size: 37px;"/>
            </VBox>
         </top>

         <!-- MENU DE NAVIGATION -->
         <center>
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        style="-fx-background: transparent; -fx-background-color: transparent;">

               <content>
                  <VBox alignment="TOP_CENTER"
                        spacing="4.0"
                        style="-fx-padding: 8 12 8 12;">

                     <!-- HOME -->
                     <JFXButton fx:id="btnHome"
                                text="Home"
                                onAction="#handleClicksAccueil"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/home.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                     <!-- NEW -->
                     <JFXButton fx:id="btnNew"
                                text="New"
                                onAction="#handleClicksNew"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/plus.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                     <!-- OPEN -->
                     <JFXButton fx:id="btnOpen"
                                text="Open"
                                onAction="#handleClicksOpen"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/open.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                     <!-- THEME -->
                     <JFXButton fx:id="btnGererThemes"
                                text="Theme"
                                onAction="#handleClicksThemes"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/Theme.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                     <!-- EXTRACT -->
                     <JFXButton fx:id="btnExtract"
                                text="Extract"
                                onAction="#handleClicksExtract"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/export.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                     <!-- IMPORT -->
                     <JFXButton fx:id="btnImport"
                                text="Import"
                                onAction="#handleClicksImport"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/import.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                     <!-- SETTING -->
                     <JFXButton fx:id="btnSetting"
                                text="Setting"
                                onAction="#handleClicksSetting"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/params.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                     <!-- HELP -->
                     <JFXButton fx:id="btnHelp"
                                text="Help"
                                onAction="#handleClicksHelp"
                                styleClass="sidebar-button"
                                prefWidth="224.0"
                                prefHeight="48.0"
                                alignment="CENTER_LEFT"
                                graphicTextGap="16.0">
                        <graphic>
                           <ImageView fitWidth="32.0"
                                      fitHeight="32.0"
                                      preserveRatio="true">
                              <image>
                                 <Image url="@images/help.png"/>
                              </image>
                           </ImageView>
                        </graphic>
                     </JFXButton>

                  </VBox>
               </content>
            </ScrollPane>
         </center>

         <!-- PIED DE PAGE -->
         <bottom>
            <VBox alignment="CENTER"
                  style="-fx-padding: 10;">

               <Label text="©2025&#10;Eya Mezzi"
                      textAlignment="CENTER"
                      textFill="WHITE"/>

            </VBox>
         </bottom>

      </BorderPane>

      <!-- CONTENU PRINCIPAL -->
      <AnchorPane fx:id="anchorpane3"
                  prefHeight="600.0"
                  prefWidth="794.0"
                  style="-fx-background-color: white;"
                  AnchorPane.topAnchor="0.0"
                  AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="256.0"
                  AnchorPane.rightAnchor="0.0"/>

   </children>
</AnchorPane>
